# Android (Capacitor native project)
android/app/build
android/build
android/.gradle
android/local.properties
android/captures
android/*.iml
android/.idea

# Signing secrets, never commit. Back the keystore up somewhere safe;
# losing it means future releases can't update installs of this app.
android/keystore/
android/keystore.properties

# iOS (Capacitor native project)
ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/App/App.xcodeproj/xcuserdata
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
ios/App/CapApp-SPM/.swiftpm
ios/App/CapApp-SPM/.build
*.xcuserstate

# Local environment config. The Firebase values in here are publishable, but
# they still don't belong in the repo: they pin one project into the source,
# and deployed builds get them from the host's environment instead.
.env
.env.*
!.env.example
