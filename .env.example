# Firebase web config for cloud backup.
#
# These are not secrets - a web app ships them to every client by design, and
# Firestore security rules are what actually protect the data. Copy this file
# to `.env.local` and fill in the values from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
#
# Leaving them unset is supported: the app builds and runs exactly as the
# local-only version, with the backup screen showing "not available".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
